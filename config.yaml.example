server:
  port: ":8082"
  gin_log: true
  read_timeout: 15s
  write_timeout: 15s
  worker_count: 4                # 并发执行流水线的 Worker 协程数量
  sandbox_dir: "./workspace"     # 流水线代码克隆与执行命令的本地沙箱目录

database:
  driver: "postgres"
  host: "127.0.0.1"
  port: 5432
  user: "postgres"
  password: "YOUR_POSTGRES_PASSWORD"
  dbname: "code_shield"
  sslmode: "disable"
  timezone: "Asia/Shanghai"
  max_open_conns: 50
  max_idle_conns: 10

auth:
  jwt_secret: "please-change-this-jwt-secret-in-production-environments-123456"
  password_login_enabled: true
  system_user_id: 1 # 用于系统间调用的虚拟或物理系统用户 ID

pipeline_system:
  get_pipeline_url: "http://192.168.56.18:8080/api/external/pipeline"
  get_execution_scheme_url: "http://192.168.56.18:8080/api/external/execution-plans"
  create_execution_scheme_url: "http://192.168.56.18:8080/api/external/execution-plans"
  create_execution_scheme_body: |
    {
      "pipeline_id": "{PIPELINE_ID}",
      "name": "{SCHEME_NAME}",
      "creator": "{USER_EMAIL}",
      "custom_attributes": "{CUSTOM_ATTRIBUTES}"
    }
  get_mr_bindings_url: "http://192.168.56.18:8080/api/external/mr-bindings"
  create_mr_binding_url: "http://192.168.56.18:8080/api/external/mr-bindings"
  create_mr_binding_body: |
     {
       "pipeline_id": "{PIPELINE_ID}",
       "scheme_id": "{SCHEME_ID}",
       "code_url": "{REPO_URL}",
       "branches": "{BRANCHES}",
       "credential_id": "{CREDENTIAL_ID}",
       "custom_attributes": "{CUSTOM_ATTRIBUTES}"
     }
  create_checker_task_url: "http://192.168.56.18:8080/api/external/create-checker-task"
  create_checker_task_body: |
    {
      "id": "{TEMPLATE_ID}",
      "name": "{NAME}",
      "copyIgnoreGroup": "false",
      "isCopyCategory": "false",
      "languages": {LANGUAGES},
      "ruleSets": {RULE_SETS}
    }
  repo_auth_check_url: "http://192.168.56.18:8080/api/external/repo-auth-check"
  get_branches_url: "http://192.168.56.18:8080/api/external/repo-branches"
  query_checker_task_url: "http://192.168.56.18:8080/api/external/query-checker-task"
  delete_checker_task_url: "http://192.168.56.18:8080/api/external/delete-checker-task"
  run_execution_scheme_url: "http://192.168.56.18:8080/api/external/run-execution-scheme"
  create_execution_plan_url: "http://192.168.56.18:8080/api/external/daily-builds"
  create_execution_plan_body: |
    {
      "pipeline_id": "{PIPELINE_ID}",
      "scheme_id": "{SCHEME_ID}",
      "time": "{DAILY_BUILD_TIME}",
      "name": "{PIPELINE_NAME}",
      "service_id": "{SERVICE_ID}",
      "workspace_id": "{WORKSPACE_ID}"
    }
  get_execution_plan_url: "http://192.168.56.18:8080/api/external/daily-builds"
  rule_sets:
    GO: "rule_id_go_1"
    PYTHON: "rule_id_py_1"
    JAVASCRIPT: "rule_id_js_1"
  pipeline_link_template: "http://192.168.56.18:9080/workspace/{OWNER_ID}/service/{SERVICE_ID}/pipeline/{PIPELINE_ID}"
  link_checker_task_url: "http://192.168.56.18:9080/shield/public/report/{TASK_ID}"
  get_webhooks_url: "http://192.168.56.18:8080/api/v1/projects/{REPO_ID}/hooks?page=1"          # 查询项目 Webhook 列表
  create_webhook_url: "http://192.168.56.18:8080/api/v1/projects/{REPO_ID}/hooks"              # 创建 Webhook
  create_webhook_body: |
    {
      "webhookUrl": "{WEBHOOK_URL}",
      "events": ["merge_request"]
    }
  webhook_callback_url: "http://192.168.56.18:8082/api/webhook"                # code-pipeline 接收 Webhook 事件的回调 URL
  update_repo_settings_url: "http://192.168.56.18:8080/api/v1/projects/{REPO_ID}/settings"      # 修改代码仓设置
  update_repo_settings_body: |                                                                  # 修改代码仓设置的请求 Body 模板
    {
      "merge_requests_enabled": true
    }

codehub:
  base_url: "http://192.168.56.18:9080/api/v1"                         # 远程 Git 平台接口的默认 BaseURL，用于建仓、保护分支以及成员ACL下发 (支持在 base_url 中自定义 API 前缀)
  get_mrs_url: "http://192.168.56.18:9080/api/v1/projects/{REPO_ID}/merge_requests"
  headers:
    Accept: "application/json"
    Content-Type: "application/json"
  create_repo_body: |
    {
      "name": "{REPO_NAME}",
      "namespace_path": "{GROUP_PATH}",
      "visibility": "private"
    }
  create_branch_body: |
    {
      "branch_name": "{BRANCH_NAME}",
      "ref": "{SOURCE_REF}"
    }
  configure_protection_body: |
    {
      "name": "{BRANCH_PATTERN}",
      "push_access_level": 0,
      "merge_access_level": 30,
      "code_review_required": true,
      "status_check_required": true
    }
  configure_acl_body: |
    {
      "principal_type": "{PRINCIPAL_TYPE}",
      "principal_id": "{PRINCIPAL_ID}",
      "access_level": {ACCESS_LEVEL}
    }

